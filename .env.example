# Used only by the Art agent (Claude Agent SDK — needs its Bash/Read/Glob/
# Write tool-execution loop to search/copy sprite assets). Get one at
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Used by the Story and Dev agents (plain OpenRouter chat completions, no
# tools). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model ids for Story/Dev's OpenRouter calls, e.g. "anthropic/claude-sonnet-4-6"
# or a free/cheap model id. No default is set here on purpose: OpenRouter's
# free-tier lineup changes often — check https://openrouter.ai/models for
# what's current before picking one. Story benefits from stronger writing
# quality; Dev is mechanical JSON-filling and tolerates a cheaper model well.
OPENROUTER_STORY_MODEL=
OPENROUTER_DEV_MODEL=
