# Used by all three agents (plain OpenRouter chat completions). Get one at
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model ids for each agent's OpenRouter calls, e.g. "anthropic/claude-sonnet-4-6"
# or a free/cheap model id. No default is set here on purpose: OpenRouter's
# free-tier lineup changes often — check https://openrouter.ai/models for
# what's current before picking one. Story benefits from stronger writing
# quality; Dev is mechanical JSON-filling and tolerates a cheaper model well.
#
# GOTCHA (found the hard way): "tools" being listed as a supported parameter
# does NOT mean a model supports response_format/json_schema — several free
# models (e.g. the NVIDIA/Thinking Machines "Ultra"-class ones) support tool
# calling but not structured outputs at all, so this pipeline's
# response_format request would have no eligible provider to route to.
# Before picking a model, filter for it explicitly: on
# https://openrouter.ai/models, open "Supported parameters" in the sidebar
# and check both "response_format" AND "structured_outputs" — only a model
# appearing under BOTH is safe to use here. You can also confirm any single
# model directly: fetch https://openrouter.ai/api/v1/models/<id>/endpoints
# and check its supported_parameters array.
OPENROUTER_STORY_MODEL=
OPENROUTER_DEV_MODEL=

# Same two requirements as above (response_format AND structured_outputs),
# PLUS vision input support — Art is shown thumbnails of sprites already
# committed to the game purely as a STYLE reference (line weight, palette,
# background treatment), then always writes a fresh, ready-to-paste
# generation prompt for the entity it's working on — it never reuses or
# points back to one of the reference images instead. On
# https://openrouter.ai/models, also check "Input modalities" includes
# "image". No free model on OpenRouter can GENERATE an image as of this
# writing (checked https://openrouter.ai/models?output_modalities=image) —
# this agent never asks one to; a human draws every sprite by hand from
# the prompt it writes. As of this writing, nex-agi/nex-n2.5-pro:free and
# dots-studio/dots-3-note-preview:free both satisfy all three
# requirements — verify they still do before using them, the free lineup
# rotates.
OPENROUTER_ART_MODEL=
