{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "cityId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "story": {
      "type": "object",
      "properties": {
        "cityId": {
          "type": "string",
          "description": "Stable slug for the whole package"
        },
        "cityName": {
          "type": "string"
        },
        "lore": {
          "type": "string",
          "description": "The city's backstory — what Art and Dev both anchor to"
        },
        "atmosphereKeywords": {
          "minItems": 3,
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Short mood/visual keywords for the Art agent, e.g. ['salt-worn wood', 'fog', 'rust']"
        },
        "levelRange": {
          "type": "object",
          "properties": {
            "min": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "max": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "npcs": {
          "minItems": 8,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "description": "Stable slug, e.g. 'harbor-master'. Referenced by quests/instances and by the Art/Dev agents' output — never renamed after Story produces it."
              },
              "name": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "enum": [
                  "MERCHANT",
                  "TELEPORTER",
                  "QUEST_GIVER",
                  "BLACKSMITH",
                  "INSTANCE_MASTER"
                ]
              },
              "personality": {
                "type": "string"
              },
              "dialogueHooks": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Short lines/topics this NPC can open a conversation with"
              }
            },
            "required": [
              "id",
              "name",
              "role",
              "personality",
              "dialogueHooks"
            ],
            "additionalProperties": false
          }
        },
        "quests": {
          "minItems": 10,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "narrative": {
                "type": "string",
                "description": "Why the NPC is asking for this"
              },
              "giverNpcId": {
                "type": "string",
                "description": "Must match one of the 3 QUEST_GIVER npcs' id"
              },
              "objectiveType": {
                "type": "string",
                "enum": [
                  "KILL_MONSTER",
                  "TALK_TO_NPC"
                ]
              },
              "objectiveSketch": {
                "type": "string",
                "description": "For KILL_MONSTER: plain-language target, e.g. 'defeat 5 bilge rats' — Dev turns this into a concrete counter. For TALK_TO_NPC: which NPC to talk to and what lore/history of this package the conversation reveals — these exist to teach the player about the new content, on top of the XP reward."
              }
            },
            "required": [
              "id",
              "title",
              "narrative",
              "giverNpcId",
              "objectiveType",
              "objectiveSketch"
            ],
            "additionalProperties": false
          }
        },
        "fields": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "atmosphere": {
                "type": "string"
              },
              "monsters": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "flavor": {
                      "type": "string",
                      "description": "One or two sentences of monster flavor text"
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "flavor"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name",
              "atmosphere",
              "monsters"
            ],
            "additionalProperties": false
          }
        },
        "portals": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "direction": {
                "type": "string",
                "enum": [
                  "NORTH",
                  "SOUTH",
                  "EAST",
                  "WEST"
                ],
                "description": "The city edge this portal sits at — exactly one portal per direction"
              },
              "fieldId": {
                "type": "string",
                "description": "Matches exactly one fields[].id — 1:1"
              }
            },
            "required": [
              "id",
              "name",
              "direction",
              "fieldId"
            ],
            "additionalProperties": false
          }
        },
        "instances": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "theme": {
                "type": "string"
              },
              "instanceMasterNpcId": {
                "type": "string",
                "description": "Must match one of the 2 INSTANCE_MASTER npcs' id"
              },
              "monsters": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "flavor": {
                      "type": "string"
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "NORMAL",
                        "BOSS"
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "name",
                    "flavor",
                    "role"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "id",
              "name",
              "theme",
              "instanceMasterNpcId",
              "monsters"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cityId",
        "cityName",
        "lore",
        "atmosphereKeywords",
        "levelRange",
        "npcs",
        "quests",
        "fields",
        "portals",
        "instances"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "properties": {
        "cityId": {
          "type": "string"
        },
        "assets": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entityId": {
                "type": "string",
                "description": "Matches an id from the StoryManifest: an npc, a fields[].monsters[] entry, or an instances[].monsters[] entry"
              },
              "relativePath": {
                "type": "string",
                "description": "Path under this package's assets/ folder, e.g. 'assets/npcs/harbor-master.png'"
              },
              "source": {
                "type": "string",
                "enum": [
                  "reused-from-pack",
                  "reused-from-repo",
                  "generated"
                ]
              },
              "sourceDetail": {
                "type": "string",
                "description": "Which pack/file it was cropped from, or a one-line description of the generation prompt"
              },
              "transparent": {
                "type": "boolean",
                "description": "Verified real alpha transparency, not a baked-in checkerboard"
              }
            },
            "required": [
              "entityId",
              "relativePath",
              "source",
              "sourceDetail",
              "transparent"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cityId",
        "assets"
      ],
      "additionalProperties": false
    },
    "dev": {
      "type": "object",
      "properties": {
        "cityId": {
          "type": "string"
        },
        "map": {
          "type": "object",
          "properties": {
            "mapId": {
              "type": "string",
              "description": "Stable slug for this map"
            },
            "name": {
              "type": "string"
            },
            "width": {
              "type": "integer",
              "minimum": 50,
              "maximum": 9007199254740991
            },
            "height": {
              "type": "integer",
              "minimum": 50,
              "maximum": 9007199254740991
            },
            "isCity": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "mapId",
            "name",
            "width",
            "height",
            "isCity"
          ],
          "additionalProperties": false
        },
        "npcPlacements": {
          "minItems": 8,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "npcId": {
                "type": "string",
                "description": "Matches StoryManifest npcs[].id"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "z": {
                    "default": 0,
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "npcId",
              "position"
            ],
            "additionalProperties": false
          }
        },
        "portalPlacements": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "portalId": {
                "type": "string",
                "description": "Matches StoryManifest portals[].id"
              },
              "position": {
                "type": "object",
                "properties": {
                  "x": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "y": {
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  },
                  "z": {
                    "default": 0,
                    "type": "integer",
                    "minimum": -9007199254740991,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "x",
                  "y",
                  "z"
                ],
                "additionalProperties": false,
                "description": "Must sit on the city map's edge matching the portal's direction"
              }
            },
            "required": [
              "portalId",
              "position"
            ],
            "additionalProperties": false
          }
        },
        "questObjectives": {
          "minItems": 10,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "questId": {
                "type": "string",
                "description": "Matches StoryManifest quests[].id"
              },
              "objectiveType": {
                "type": "string",
                "enum": [
                  "KILL_MONSTER",
                  "TALK_TO_NPC"
                ]
              },
              "objectiveTarget": {
                "type": "string",
                "description": "A field monster id for KILL_MONSTER, or an npc id for TALK_TO_NPC"
              },
              "objectiveRequiredCount": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "minLevel": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "expReward": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "goldReward": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "itemRewardIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "prerequisiteQuestIds": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "questId",
              "objectiveType",
              "objectiveTarget",
              "objectiveRequiredCount",
              "minLevel",
              "expReward",
              "goldReward",
              "itemRewardIds",
              "prerequisiteQuestIds"
            ],
            "additionalProperties": false
          }
        },
        "fieldMaps": {
          "minItems": 4,
          "maxItems": 4,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fieldId": {
                "type": "string",
                "description": "Matches StoryManifest fields[].id"
              },
              "mapId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 50,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 50,
                "maximum": 9007199254740991
              },
              "monsterStats": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "monsterId": {
                      "type": "string",
                      "description": "Matches a fields[].monsters[].id in StoryManifest"
                    },
                    "level": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxHp": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "attack": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "defense": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "expReward": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "goldReward": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "respawnTimeSeconds": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "spawnPositions": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "x": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "y": {
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          },
                          "z": {
                            "default": 0,
                            "type": "integer",
                            "minimum": -9007199254740991,
                            "maximum": 9007199254740991
                          }
                        },
                        "required": [
                          "x",
                          "y",
                          "z"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "drops": {
                      "minItems": 3,
                      "maxItems": 3,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "itemId": {
                            "type": "string"
                          },
                          "itemName": {
                            "type": "string"
                          },
                          "rarity": {
                            "type": "string",
                            "enum": [
                              "COMMON",
                              "RARE"
                            ]
                          },
                          "dropRate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "itemId",
                          "itemName",
                          "rarity",
                          "dropRate"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "monsterId",
                    "level",
                    "maxHp",
                    "attack",
                    "defense",
                    "expReward",
                    "goldReward",
                    "respawnTimeSeconds",
                    "spawnPositions",
                    "drops"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "fieldId",
              "mapId",
              "name",
              "width",
              "height",
              "monsterStats"
            ],
            "additionalProperties": false
          }
        },
        "instances": {
          "minItems": 2,
          "maxItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "instanceId": {
                "type": "string",
                "description": "Matches StoryManifest instances[].id"
              },
              "mapId": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "width": {
                "type": "integer",
                "minimum": 20,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "minimum": 20,
                "maximum": 9007199254740991
              },
              "monsterStats": {
                "minItems": 3,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "monsterId": {
                      "type": "string",
                      "description": "Matches an instances[].monsters[].id in StoryManifest"
                    },
                    "level": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "maxHp": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "attack": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "defense": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "expReward": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "goldReward": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "drops": {
                      "default": [],
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "itemId": {
                            "type": "string"
                          },
                          "itemName": {
                            "type": "string"
                          },
                          "rarity": {
                            "type": "string",
                            "enum": [
                              "COMMON",
                              "RARE"
                            ]
                          },
                          "dropRate": {
                            "type": "number",
                            "minimum": 0,
                            "maximum": 100
                          }
                        },
                        "required": [
                          "itemId",
                          "itemName",
                          "rarity",
                          "dropRate"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "monsterId",
                    "level",
                    "maxHp",
                    "attack",
                    "defense",
                    "expReward",
                    "goldReward",
                    "drops"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "instanceId",
              "mapId",
              "name",
              "width",
              "height",
              "monsterStats"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cityId",
        "map",
        "npcPlacements",
        "portalPlacements",
        "questObjectives",
        "fieldMaps",
        "instances"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "cityId",
    "generatedAt",
    "story",
    "assets",
    "dev"
  ],
  "additionalProperties": false
}
